# Copy to .env for local API and administrative scripts. Never commit real values.
NODE_ENV=development
PORT=4000
# Local opcional. Para Atlas sustituye por la URI mongodb+srv:// de Connect > Drivers,
# indicando /uniformes_ellas antes de ? (sin publicar usuario ni contraseña).
MONGODB_URI=mongodb://127.0.0.1:27017/uniformes_ellas
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
ORDER_NOTIFICATION_TO=ugasdomingo@gmail.com
EMAIL_REDIRECT_TO=ugasdomingo@gmail.com
# Resend HTTPS API, with a verified sender belonging to your account.
EMAIL_FROM=
EMAIL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17
AI_DAILY_CALL_LIMIT=200
AI_SESSION_DAILY_LIMIT=20
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=30000
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Optional, only for npm run users:demo. Generated privately when absent.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# Optional private S3-compatible object store. Without these, logos use MongoDB GridFS.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nuxt reads NUXT_* variables in its own environment (apps/web/.env locally).
NUXT_API_INTERNAL_URL=http://127.0.0.1:4000
NUXT_PUBLIC_APP_URL=http://localhost:3000
